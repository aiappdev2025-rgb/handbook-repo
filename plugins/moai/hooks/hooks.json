  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/state-banner.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
